{
  "name": "orca-plugins",
  "private": true,
  "type": "module",
  "description": "Orca plugins, one folder per plugin under plugins/.",
  "repository": "https://github.com/eliasjnior/orca-plugins",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "types": "node scripts/orca-types.mjs",
    "vendor": "node scripts/vendor.mjs",
    "binaries": "node scripts/check-binaries.mjs",
    "typecheck": "node scripts/each-plugin.mjs typecheck",
    "test": "node scripts/each-plugin.mjs test",
    "validate": "node scripts/each-plugin.mjs validate",
    "check": "node scripts/each-plugin.mjs check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "catalog": "node scripts/catalog.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "geist": "^1.9.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "config": {
    "orcaVersion": "1.4.247"
  }
}
