{
  "name": "orca-worktree-notes",
  "private": true,
  "type": "module",
  "description": "An Orca plugin. Notion-style Markdown notes for each worktree, in the right sidebar.",
  "repository": "https://github.com/eliasjnior/orca-worktree-notes",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "types": "node scripts/orca-types.mjs",
    "vendor": "node scripts/vendor.mjs",
    "binaries": "node scripts/check-binaries.mjs",
    "typecheck": "tsc -p .",
    "test": "orca plugin test .",
    "validate": "orca plugin validate .",
    "check": "orca plugin check .",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "geist": "^1.9.0",
    "typescript": "^7.0.2"
  },
  "config": {
    "orcaVersion": "1.4.247"
  }
}
